{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/revazi/pi-reads/schemas/v1/search-index.schema.json",
  "title": "Pi Reads Derived Full-Text Search Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "corpusHash", "indexHash", "documentCount", "averageDocumentLength", "documents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "bm25-lexical-v1" },
    "corpusHash": { "$ref": "common.schema.json#/$defs/contentHash" },
    "indexHash": { "$ref": "common.schema.json#/$defs/contentHash" },
    "documentCount": { "type": "integer", "minimum": 0 },
    "averageDocumentLength": { "type": "number", "minimum": 0 },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "articleId", "mode", "title", "authors", "canonicalUrls", "sourceIds", "createdAt", "contentHash",
          "blocks", "documentLength", "termFrequencies"
        ],
        "properties": {
          "articleId": { "type": "string", "pattern": "^art_[a-z0-9]{16,64}$" },
          "mode": { "enum": ["archive", "digest", "synthesis"] },
          "title": { "type": "string", "minLength": 1 },
          "authors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "canonicalUrls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^src_[a-z0-9]{16,64}$" }
          },
          "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "contentHash": { "$ref": "common.schema.json#/$defs/contentHash" },
          "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "status": { "type": "string", "minLength": 1 },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locator", "startByte", "endByte", "textHash"],
              "properties": {
                "locator": { "type": "string", "pattern": "^[hpb]_[0-9a-f]{16}_[1-9][0-9]*$" },
                "startByte": { "type": "integer", "minimum": 0 },
                "endByte": { "type": "integer", "minimum": 1 },
                "textHash": { "$ref": "common.schema.json#/$defs/contentHash" }
              }
            }
          },
          "documentLength": { "type": "integer", "minimum": 0 },
          "termFrequencies": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                { "type": "string", "minLength": 1 },
                { "type": "integer", "minimum": 1 }
              ],
              "items": false
            }
          }
        }
      }
    }
  }
}
