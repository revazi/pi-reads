{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/revazi/pi-reads/schemas/v1/article.schema.json",
  "title": "Pi Reads Article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "mode",
    "title",
    "slug",
    "sourceIds",
    "body",
    "citations",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^art_[a-z0-9]{16,64}$"
    },
    "mode": {
      "enum": ["archive", "digest", "synthesis"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "description": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^src_[a-z0-9]{16,64}$"
      }
    },
    "body": {
      "$ref": "common.schema.json#/$defs/storedText"
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "citation.schema.json"
      }
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "supersedesArticleId": {
      "type": "string",
      "pattern": "^art_[a-z0-9]{16,64}$"
    },
    "archiveVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceTextHash"],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^src_[a-z0-9]{16,64}$"
        },
        "sourceTextHash": {
          "$ref": "common.schema.json#/$defs/contentHash"
        },
        "verifiedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "generatedAt"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "thinkingLevel": {
          "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "sources"],
      "properties": {
        "policy": {
          "enum": ["complete", "targeted"]
        },
        "warning": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "sourceContentHash",
              "indexAlgorithm",
              "indexLocatorHash",
              "consideredLocatorHash",
              "consideredLocatorCount",
              "totalLocatorCount",
              "missingLocatorCount",
              "missingLocators",
              "missingLocatorsTruncated"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^src_[a-z0-9]{16,64}$"
              },
              "sourceContentHash": {
                "$ref": "common.schema.json#/$defs/contentHash"
              },
              "indexAlgorithm": {
                "const": "markdown-blocks-v1"
              },
              "indexLocatorHash": {
                "$ref": "common.schema.json#/$defs/contentHash"
              },
              "consideredLocatorHash": {
                "$ref": "common.schema.json#/$defs/contentHash"
              },
              "consideredLocatorCount": {
                "type": "integer",
                "minimum": 1
              },
              "totalLocatorCount": {
                "type": "integer",
                "minimum": 1
              },
              "missingLocatorCount": {
                "type": "integer",
                "minimum": 0
              },
              "missingLocators": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "pattern": "^[hp]_[0-9a-f]{16}_[1-9][0-9]*$"
                }
              },
              "missingLocatorsTruncated": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": { "const": "targeted" }
            },
            "required": ["policy"]
          },
          "then": {
            "required": ["warning"]
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceFontStyle": {
          "enum": ["serif", "sans-serif"]
        },
        "bodyFontSizeAdjustment": {
          "const": -1
        },
        "imageScalePercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "archive"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["archiveVerification"],
        "properties": {
          "sourceIds": {
            "type": "array",
            "maxItems": 1
          },
          "body": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^articles/archive/art_[a-z0-9]{16,64}/content\\.md$"
              }
            }
          }
        },
        "allOf": [
          {
            "not": {
              "required": ["generatedBy"]
            }
          },
          {
            "not": {
              "required": ["sourceCoverage"]
            }
          }
        ]
      },
      "else": {
        "required": ["generatedBy"],
        "properties": {
          "citations": {
            "type": "array",
            "minItems": 1
          }
        },
        "not": {
          "required": ["archiveVerification"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "digest"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^articles/digest/art_[a-z0-9]{16,64}/content\\.md$"
              }
            }
          },
          "sourceCoverage": {
            "type": "object",
            "properties": {
              "policy": {
                "const": "complete"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "synthesis"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^articles/synthesis/art_[a-z0-9]{16,64}/content\\.md$"
              }
            }
          }
        }
      }
    }
  ]
}
