{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/revazi/pi-reads/schemas/v1/source.schema.json",
  "title": "Pi Reads Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "capturedAt",
    "origin",
    "content",
    "capture"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^src_[a-z0-9]{16,64}$"
    },
    "kind": {
      "enum": ["url", "text", "markdown", "file"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "publishedAt": {
      "type": "string",
      "minLength": 4
    },
    "capturedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator"],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "content": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/storedText"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^sources/src_[a-z0-9]{16,64}/content\\.md$"
            },
            "mediaType": {
              "type": "string",
              "const": "text/markdown"
            }
          }
        }
      ]
    },
    "rawCapture": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/storedFile"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^sources/src_[a-z0-9]{16,64}/raw/"
            }
          }
        }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/storedFile"
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^sources/src_[a-z0-9]{16,64}/assets/"
              }
            }
          }
        ]
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        },
        "extractor": {
          "type": "string",
          "minLength": 1
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "url"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "origin": {
            "type": "object",
            "required": ["canonicalUrl"]
          }
        }
      }
    }
  ]
}
