{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/revazi/pi-reads/schemas/v1/citation-diagnostics.schema.json",
  "title": "Pi Reads Citation Grounding Diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "citationCount",
    "locatedCitationCount",
    "verifiedQuoteCount",
    "sourceCount",
    "sources",
    "sourcesTruncated",
    "articleSectionCount",
    "citedArticleSectionCount",
    "uncitedArticleSectionCount",
    "articleSections",
    "articleSectionsTruncated",
    "uncitedArticleSections",
    "uncitedArticleSectionsTruncated"
  ],
  "properties": {
    "algorithm": { "const": "citation-grounding-v1" },
    "citationCount": { "type": "integer", "minimum": 1 },
    "locatedCitationCount": { "type": "integer", "minimum": 0 },
    "verifiedQuoteCount": { "type": "integer", "minimum": 0 },
    "sourceCount": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "citationCount",
          "locatedCitationCount",
          "verifiedQuoteCount",
          "sectionCitationCounts",
          "sectionCitationCountsTruncated",
          "missingLocatorCount",
          "missingLocatorCitationIds",
          "missingLocatorCitationIdsTruncated"
        ],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^src_[a-z0-9]{16,64}$" },
          "citationCount": { "type": "integer", "minimum": 0 },
          "locatedCitationCount": { "type": "integer", "minimum": 0 },
          "verifiedQuoteCount": { "type": "integer", "minimum": 0 },
          "sectionCitationCounts": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locator", "citationCount"],
              "properties": {
                "locator": {
                  "type": "string",
                  "pattern": "^[hp]_[0-9a-f]{16}_[1-9][0-9]*(\\.\\.[hp]_[0-9a-f]{16}_[1-9][0-9]*)?$"
                },
                "citationCount": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "sectionCitationCountsTruncated": { "type": "boolean" },
          "missingLocatorCount": { "type": "integer", "minimum": 0 },
          "missingLocatorCitationIds": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "pattern": "^cite_[a-z0-9][a-z0-9_-]{0,63}$" }
          },
          "missingLocatorCitationIdsTruncated": { "type": "boolean" }
        }
      }
    },
    "sourcesTruncated": { "type": "boolean" },
    "articleSectionCount": { "type": "integer", "minimum": 1 },
    "citedArticleSectionCount": { "type": "integer", "minimum": 0 },
    "uncitedArticleSectionCount": { "type": "integer", "minimum": 0 },
    "articleSections": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/articleSection" }
    },
    "articleSectionsTruncated": { "type": "boolean" },
    "uncitedArticleSections": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/sectionIdentity" }
    },
    "uncitedArticleSectionsTruncated": { "type": "boolean" }
  },
  "$defs": {
    "sectionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^section_[0-9a-f]{12}_[1-9][0-9]*$" },
        "heading": { "type": "string", "minLength": 1, "maxLength": 160 },
        "headingTruncated": { "type": "boolean" }
      }
    },
    "articleSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "citationCount", "citationIds", "citationIdsTruncated"],
      "properties": {
        "id": { "type": "string", "pattern": "^section_[0-9a-f]{12}_[1-9][0-9]*$" },
        "heading": { "type": "string", "minLength": 1, "maxLength": 160 },
        "headingTruncated": { "type": "boolean" },
        "citationCount": { "type": "integer", "minimum": 0 },
        "citationIds": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^cite_[a-z0-9][a-z0-9_-]{0,63}$" }
        },
        "citationIdsTruncated": { "type": "boolean" }
      }
    }
  }
}
