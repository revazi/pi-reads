{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/revazi/pi-reads/schemas/v1/config.schema.json",
  "title": "Pi Reads configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "libraryDir": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["archive", "digest", "synthesis"]
        },
        "exportFormat": {
          "enum": ["markdown", "html", "pdf", "epub"]
        }
      }
    },
    "obsidian": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vaultPath"],
      "properties": {
        "vaultPath": {
          "type": "string",
          "minLength": 1
        },
        "vaultName": {
          "type": "string",
          "minLength": 1
        },
        "inboxFolder": {
          "type": "string",
          "minLength": 1
        },
        "attachmentFolder": {
          "type": "string",
          "minLength": 1
        },
        "noteNameTemplate": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frontmatter": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "openAfterExport": {
          "type": "boolean"
        }
      }
    }
  }
}
